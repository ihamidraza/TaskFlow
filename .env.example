# Copy to .env and adjust:  cp .env.example .env
# .env is gitignored. Never commit real secrets.

APP_NAME=TaskFlow API
APP_ENV=development          # development | testing | production
DEBUG=true                   # must be false in production

# Matches compose.yaml (dev-only credentials)
DATABASE_URL=postgresql+asyncpg://taskflow:taskflow_dev@localhost:5432/taskflow

# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-with-secure-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=taskflow-api
JWT_AUDIENCE=taskflow-api
ACCESS_TOKEN_EXPIRE_MINUTES=30

LOG_LEVEL=INFO
